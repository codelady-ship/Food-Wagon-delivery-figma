# Copy to .env for local runs. Never commit .env.
PORT=4000
# MongoDB Atlas connection string (free M0 cluster) or local mongodb://127.0.0.1:27017/food-wagon
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food-wagon
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Admin account, created or updated on every start (log in on admin.html)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
# Public read-only demo admin (admin@foodwagon.demo / demo-admin) is seeded by default and sees placeholders instead of
# personal data. DEMO_ADMIN=false turns it off: login refused, issued demo tokens rejected, account deleted on start.
# DEMO_ADMIN=false
# Comma-separated list of sites allowed to call the API
CORS_ORIGINS=https://codelady-ship.github.io,http://localhost:5173,http://localhost:4173
# Fill empty collections from data/seed.json on start (default true)
SEED_ON_START=true
# Optional: public base URL of this API, used in uploaded image links (default: taken from the request)
PUBLIC_API_URL=
